root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = true

[*.{kt,kts}]
# Jetpack Compose's convention capitalizes @Composable UI functions; ordinary Kotlin functions remain lowercase.
ktlint_function_naming_ignore_when_annotated_with = Composable
